# micro-ROS: XRCE-DDS + UART transport
# (实际使用 USB Serial/JTAG 自定义传输, 在运行时通过 rmw_uros_set_custom_transport 覆盖)
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_UART_TRANSPORT=y

# Console: 保持旧项目设置, printf 输出到 USB Serial/JTAG (ACM1)
# 和 UART0 (默认) 同时输出

# main task stack size (app_main 中有较大局部数据)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WiFi Remote default settings (ESP32-P4 外挂 WiFi 芯片)
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=10
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_WIFI_RMT_TX_BUFFER_TYPE=1
CONFIG_WIFI_RMT_DYNAMIC_RX_MGMT_BUF=0
CONFIG_WIFI_RMT_ESPNOW_MAX_ENCRYPT_NUM=7
