# micro-ROS: custom transport (USB Serial/JTAG) instead of WiFi/Ethernet
CONFIG_MICRO_ROS_ESP_XRCE_DDS_MIDDLEWARE=y
CONFIG_MICRO_ROS_ESP_CUSTOM_TRANSPORT=y

# USB Serial/JTAG driver buffer sizes
CONFIG_MICROROS_USJT_TX_BUF_SIZE=1024
CONFIG_MICROROS_USJT_RX_BUF_SIZE=1024

# main task stack size (app_main 中有较大局部数据)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# micro-ROS task settings
CONFIG_MICROROS_TASK_STACK_SIZE=8192
CONFIG_MICROROS_TASK_PRIO=4